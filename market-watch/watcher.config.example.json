{
  "_comment": "Copy to watcher.config.json and edit. Or build a watchlist and alerts in the web app and use Settings -> Export for watcher.",

  "settings": {
    "demoMode": true,
    "refreshSeconds": 300,
    "coinGeckoKey": "",
    "alphaVantageKey": "",
    "finnhubKey": ""
  },

  "watchlist": [
    { "symbol": "BTC", "assetType": "crypto" },
    { "symbol": "ETH", "assetType": "crypto" },
    { "symbol": "SPY", "assetType": "stock" },
    { "symbol": "NVDA", "assetType": "stock" }
  ],

  "rules": [
    {
      "id": "btc-target",
      "symbol": "BTC",
      "assetType": "crypto",
      "kind": "price_above",
      "params": { "value": 150000 },
      "cooldownMinutes": 120,
      "repeat": true,
      "note": "take some profit"
    },
    {
      "id": "btc-stop",
      "symbol": "BTC",
      "assetType": "crypto",
      "kind": "price_below",
      "params": { "value": 90000 },
      "cooldownMinutes": 120,
      "repeat": true
    },
    {
      "id": "big-moves",
      "symbol": "ETH",
      "assetType": "crypto",
      "kind": "pct_change",
      "params": { "direction": "either", "percent": 8 },
      "cooldownMinutes": 240
    },
    {
      "id": "spy-regime",
      "symbol": "SPY",
      "assetType": "stock",
      "kind": "regime_change",
      "params": { "to": "any" },
      "cooldownMinutes": 1440,
      "note": "the market tone just changed"
    },
    {
      "id": "nvda-unusual",
      "symbol": "NVDA",
      "assetType": "stock",
      "kind": "unusual_move",
      "params": { "zscore": 2.5 },
      "cooldownMinutes": 720
    }
  ],

  "watcher": {
    "desktopNotifications": true,
    "speak": false,
    "webhooks": [],
    "command": null,
    "logFile": "watcher-events.log",
    "stateFile": ".watcher-state.json",
    "quietHours": null
  }
}
